# project-aibo environment variables
# Production values live in the Vercel dashboard. For local dev, copy this
# file to .env.local in the BUILD MIRROR (%LOCALAPPDATA%\project-aibo-build),
# never commit real values.

# --- In use now (Phase 0+) ---------------------------------------------------
# OpenRouter API key — primary provider for /api/brain (free-model rotation).
OPENROUTER_API_KEY=

# Google Gemini API key — fallback provider for /api/brain (and multimodal vision later).
GOOGLE_GEMINI_API_KEY=

# Upstash Redis REST URL — rate limiting now, memory/budget logging in later phases.
# Created by the Upstash KV integration in the Vercel dashboard. If unset, rate limiting no-ops.
KV_REST_API_URL=

# Upstash Redis REST token — pairs with KV_REST_API_URL.
KV_REST_API_TOKEN=

# --- Model router (Phase 2, all optional — sensible defaults in code) ---------
# Tier 3 deep model(s) via OpenRouter, comma-separated candidates tried in order.
# Default: deepseek/deepseek-r1:free,deepseek/r1-0528:free. Set a paid model here later if desired.
OPENROUTER_DEEP_MODEL=

# Comma-separated Gemini model candidates for tier 1 (cheapest). Default: gemini-2.5-flash-lite,gemini-2.0-flash-lite.
GEMINI_SMALL_MODEL=

# Comma-separated Gemini model candidates for tier 2 (main). Default: gemini-2.5-flash,gemini-2.0-flash.
GEMINI_MAIN_MODEL=

# Max tier-3 (deep model) calls per day before downgrading to tier 2. Default: 20.
BUDGET_TIER3_PER_DAY=

# Vision model(s) via OpenRouter for webcam requests (Phase 6), comma-separated candidates.
# Optional. Default: meta-llama/llama-3.2-11b-vision-instruct. Alternative: google/gemini-flash-1.5-8b.
VISION_MODEL=

# --- Coming in later phases ---------------------------------------------------
# Groq API key — Whisper large-v3-turbo speech-to-text via /api/stt (Phase 4).
GROQ_API_KEY=

# Owner secret phrase — unlocks /api/stats now (Phase 2) and Adam's persistent memory (owner mode, Phase 7).
OWNER_KEY=

# Secret header value for the Vercel cron that triggers nightly memory consolidation /api/sleep (Phase 7).
CRON_SECRET=
